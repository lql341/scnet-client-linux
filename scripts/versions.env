# Pinned versions for the Linux build. This file is the single source of truth:
# scripts/build-linux.sh sources it, scripts/check-upstream.sh reports from it and
# scripts/check-docs.sh verifies that documentation does not drift from it.
#
# Every value can be overridden from the environment, which keeps the build
# usable for testing a candidate release without editing the repository.

# Electron runtime shipped inside SCNet-<version>-x64.zip
# (Frameworks/Electron Framework.framework/Versions/A/Resources/Info.plist).
ELECTRON_VERSION="${ELECTRON_VERSION:-44.7.0}"

# Native node modules, pinned exactly by the vendor app.asar/package.json.
CANVAS_VERSION="${CANVAS_VERSION:-1.0.2}"
CUA_DRIVER_VERSION="${CUA_DRIVER_VERSION:-0.34.1}"
UBJS_VERSION="${UBJS_VERSION:-0.31.0-3}"
NODE_PTY_VERSION="${NODE_PTY_VERSION:-1.1.0}"

# Standalone binaries shipped in Resources/.
AGENT_BROWSER_VERSION="${AGENT_BROWSER_VERSION:-0.39.0}"
UV_VERSION="${UV_VERSION:-0.9.9}"

# Packaging revision, independent of the upstream version. Counted from 1 for
# each upstream release; see CHANGELOG.md.
DEB_REVISION="${DEB_REVISION:-5}"

# SHA-512 of SCNet-<version>-x64.zip as published in latest-mac.yml, with the
# base64 value decoded to hexadecimal.
MAC_ZIP_SHA512="${MAC_ZIP_SHA512:-a81c7fd1b28c3e2f52105c48dbb290a821705f55deed347bc66c1a8dfab0eb574e0f8f05d16ded94e31d7be9d34adee3f3eb9106ec386afb25129a0e8f79dcd2}"
